digraph ERD { graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=12, label=<<FONT POINT-SIZE="18">Artist applications</FONT><BR/><FONT POINT-SIZE="10">Parent: 1 or 0..1 | Child: 0..* or 0..1 | PK primary key | FK foreign key | UQ unique</FONT>>, labelloc=t, nodesep=0.65, ranksep=1.5, pad=0.4, splines=ortho, concentrate=false]; node [shape=plain, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.7, dir=both, arrowhead=none, arrowtail=none, labeldistance=2.4];
"artist_application" [id="table-artist_application", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>ARTIST_APPLICATION</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_user_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK UQ</TD><TD PORT="out_user_id" ALIGN="LEFT">user_id</TD></TR><TR><TD PORT="in_hourly_rate" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_hourly_rate" ALIGN="LEFT">hourly_rate</TD></TR><TR><TD PORT="in_tin_number" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_tin_number" ALIGN="LEFT">tin_number</TD></TR><TR><TD PORT="in_bio" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_bio" ALIGN="LEFT">bio</TD></TR><TR><TD PORT="in_bir_certificate" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_bir_certificate" ALIGN="LEFT">bir_certificate</TD></TR><TR><TD PORT="in_bir_certificate_name" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_bir_certificate_name" ALIGN="LEFT">bir_certificate_name</TD></TR><TR><TD PORT="in_bir_expires_on" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_bir_expires_on" ALIGN="LEFT">bir_expires_on</TD></TR><TR><TD PORT="in_sworn_declaration" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_sworn_declaration" ALIGN="LEFT">sworn_declaration</TD></TR><TR><TD PORT="in_sworn_declaration_name" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_sworn_declaration_name" ALIGN="LEFT">sworn_declaration_name</TD></TR><TR><TD PORT="in_document_details" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_document_details" ALIGN="LEFT">document_details</TD></TR><TR><TD PORT="in_portfolio" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_portfolio" ALIGN="LEFT">portfolio</TD></TR><TR><TD PORT="in_status" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_status" ALIGN="LEFT">status</TD></TR><TR><TD PORT="in_rejection_reason" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_rejection_reason" ALIGN="LEFT">rejection_reason</TD></TR><TR><TD PORT="in_submitted_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_submitted_at" ALIGN="LEFT">submitted_at</TD></TR><TR><TD PORT="in_updated_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_updated_at" ALIGN="LEFT">updated_at</TD></TR></TABLE>>];
"artist_registration_update" [id="table-artist_registration_update", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>ARTIST_REGISTRATION_UPDATE</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_application_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_application_id" ALIGN="LEFT">application_id</TD></TR><TR><TD PORT="in_tin_number" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_tin_number" ALIGN="LEFT">tin_number</TD></TR><TR><TD PORT="in_evidence_image" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_evidence_image" ALIGN="LEFT">evidence_image</TD></TR><TR><TD PORT="in_expires_on" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_expires_on" ALIGN="LEFT">expires_on</TD></TR><TR><TD PORT="in_previous_record" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_previous_record" ALIGN="LEFT">previous_record</TD></TR><TR><TD PORT="in_status" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_status" ALIGN="LEFT">status</TD></TR><TR><TD PORT="in_review_note" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_review_note" ALIGN="LEFT">review_note</TD></TR><TR><TD PORT="in_reviewed_by_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_reviewed_by_id" ALIGN="LEFT">reviewed_by_id</TD></TR><TR><TD PORT="in_submitted_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_submitted_at" ALIGN="LEFT">submitted_at</TD></TR><TR><TD PORT="in_reviewed_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_reviewed_at" ALIGN="LEFT">reviewed_at</TD></TR></TABLE>>];
"artist_application_log" [id="table-artist_application_log", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>ARTIST_APPLICATION_LOG</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_application_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_application_id" ALIGN="LEFT">application_id</TD></TR><TR><TD PORT="in_actor_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_actor_id" ALIGN="LEFT">actor_id</TD></TR><TR><TD PORT="in_action" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_action" ALIGN="LEFT">action</TD></TR><TR><TD PORT="in_previous_status" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_previous_status" ALIGN="LEFT">previous_status</TD></TR><TR><TD PORT="in_new_status" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_new_status" ALIGN="LEFT">new_status</TD></TR><TR><TD PORT="in_reason" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_reason" ALIGN="LEFT">reason</TD></TR><TR><TD PORT="in_created_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_created_at" ALIGN="LEFT">created_at</TD></TR></TABLE>>];
"user" [id="table-user", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>USER</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR></TABLE>>];
"user":"out_id":e -> "artist_application":"in_user_id":w [id="relationship-0", arrowtail="tee", arrowhead="odottee", tooltip="user.id → artist_application.user_id | one-to-one | parent 1 child 0..1"];
"artist_application":"out_id":e -> "artist_registration_update":"in_application_id":w [id="relationship-1", arrowtail="tee", arrowhead="crowodot", tooltip="artist_application.id → artist_registration_update.application_id | one-to-many | parent 1 child 0..*"];
"user":"out_id":e -> "artist_registration_update":"in_reviewed_by_id":w [id="relationship-2", arrowtail="odottee", arrowhead="crowodot", tooltip="user.id → artist_registration_update.reviewed_by_id | one-to-many | parent 0..1 child 0..*"];
"artist_application":"out_id":e -> "artist_application_log":"in_application_id":w [id="relationship-3", arrowtail="tee", arrowhead="crowodot", tooltip="artist_application.id → artist_application_log.application_id | one-to-many | parent 1 child 0..*"];
"user":"out_id":e -> "artist_application_log":"in_actor_id":w [id="relationship-4", arrowtail="odottee", arrowhead="crowodot", tooltip="user.id → artist_application_log.actor_id | one-to-many | parent 0..1 child 0..*"];
