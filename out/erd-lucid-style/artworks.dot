digraph ERD { graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=12, label=<<FONT POINT-SIZE="18">Artworks</FONT><BR/><FONT POINT-SIZE="10">Parent: 1 or 0..1 | Child: 0..* or 0..1 | PK primary key | FK foreign key | UQ unique</FONT>>, labelloc=t, nodesep=0.65, ranksep=1.5, pad=0.4, splines=ortho, concentrate=false]; node [shape=plain, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.7, dir=both, arrowhead=none, arrowtail=none, labeldistance=2.4];
"artwork" [id="table-artwork", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>ARTWORK</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_artist_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_artist_id" ALIGN="LEFT">artist_id</TD></TR><TR><TD PORT="in_title" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_title" ALIGN="LEFT">title</TD></TR><TR><TD PORT="in_description" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_description" ALIGN="LEFT">description</TD></TR><TR><TD PORT="in_category" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_category" ALIGN="LEFT">category</TD></TR><TR><TD PORT="in_categories" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_categories" ALIGN="LEFT">categories</TD></TR><TR><TD PORT="in_tags" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_tags" ALIGN="LEFT">tags</TD></TR><TR><TD PORT="in_price" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_price" ALIGN="LEFT">price</TD></TR><TR><TD PORT="in_hours" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_hours" ALIGN="LEFT">hours</TD></TR><TR><TD PORT="in_hourly_rate" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_hourly_rate" ALIGN="LEFT">hourly_rate</TD></TR><TR><TD PORT="in_material_cost" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_material_cost" ALIGN="LEFT">material_cost</TD></TR><TR><TD PORT="in_art_type" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_art_type" ALIGN="LEFT">art_type</TD></TR><TR><TD PORT="in_image_data" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_image_data" ALIGN="LEFT">image_data</TD></TR><TR><TD PORT="in_additional_images" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_additional_images" ALIGN="LEFT">additional_images</TD></TR><TR><TD PORT="in_status" ALIGN="LEFT"