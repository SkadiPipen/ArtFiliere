"artwork_similarity_match" [id="table-artwork_similarity_match", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>ARTWORK_SIMILARITY_MATCH</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_artwork_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_artwork_id" ALIGN="LEFT">artwork_id</TD></TR><TR><TD PORT="in_reference_artwork_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_reference_artwork_id" ALIGN="LEFT">reference_artwork_id</TD></TR><TR><TD PORT="in_phash_distance" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_phash_distance" ALIGN="LEFT">phash_distance</TD></TR><TR><TD PORT="in_dhash_distance" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_dhash_distance" ALIGN="LEFT">dhash_distance</TD></TR><TR><TD PORT="in_edge_hash_distance" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_edge_hash_distance" ALIGN="LEFT">edge_hash_distance</TD></TR><TR><TD PORT="in_feature_match_score" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_feature_match_score" ALIGN="LEFT">feature_match_score</TD></TR><TR><TD PORT="in_color_similarity_score" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_color_similarity_score" ALIGN="LEFT">color_similarity_score</TD></TR><TR><TD PORT="in_confidence_score" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_confidence_score" ALIGN="LEFT">confidence_score</TD></TR><TR><TD PORT="in_review_status" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_review_status" ALIGN="LEFT">review_status</TD></TR><TR><TD PORT="in_reviewed_by_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_reviewed_by_id" ALIGN="LEFT">reviewed_by_id</TD></TR><TR><TD PORT="in_review_note" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_review_note" ALIGN="LEFT">review_note</TD></TR><TR><TD POR