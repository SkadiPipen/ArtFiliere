digraph ERD { graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=12, label=<<FONT POINT-SIZE="18">Auctions</FONT><BR/><FONT POINT-SIZE="10">Parent: 1 or 0..1 | Child: 0..* or 0..1 | PK primary key | FK foreign key | UQ unique</FONT>>, labelloc=t, nodesep=0.65, ranksep=1.5, pad=0.4, splines=ortho, concentrate=false]; node [shape=plain, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.7, dir=both, arrowhead=none, arrowtail=none, labeldistance=2.4];
"auction" [id="table-auction", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>AUCTION</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_platform_defaults_snapshot" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_platform_defaults_snapshot" ALIGN="LEFT">platform_defaults_snapshot</TD></TR><TR><TD PORT="in_artist_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_artist_id" ALIGN="LEFT">artist_id</TD></TR><TR><TD PORT="in_artwork_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_artwork_id" ALIGN="LEFT">artwork_id</TD></TR><TR><TD PORT="in_starting_bid" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_starting_bid" ALIGN="LEFT">starting_bid</TD></TR><TR><TD PORT="in_current_bid" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_current_bid" ALIGN="LEFT">current_bid</TD></TR><TR><TD PORT="in_bid_increment" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_bid_increment" ALIGN="LEFT">bid_increment</TD></TR><TR><TD PORT="in_start_time" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_start_time" ALIGN="LEFT">start_time</TD></TR><TR><TD PORT="in_end_time" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_end_time" ALIGN="LEFT">end_time</TD></TR><TR><TD PORT="in_status" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_status" ALIGN="LEFT">status</TD></TR><TR><TD PORT="in_highest_bidder_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_highest_bidder_id" ALIGN="LEFT">highest_bidder_id</TD></TR><TR><TD PORT="in_is_physical" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_is_physical" ALIGN="LEFT">is_physical</TD></TR><TR><TD PORT="in_license_type" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_license_type" ALIGN="LEFT">license_type</TD></TR><TR><TD PORT="in_exclusivity" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_exclusivity" ALIGN="LEFT">exclusivity</TD></TR><TR><TD PORT="in_delivery_type" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_delivery_type" ALIGN="LEFT">delivery_type</TD></TR><TR><TD PORT="in_terms_snapshot" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_terms_snapshot" ALIGN="LEFT">terms_snapshot</TD></TR><TR><TD PORT="in_signed_document" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_signed_document" ALIGN="LEFT">signed_document</TD></TR><TR><TD PORT="in_signed_document_hash" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_signed_document_hash" ALIGN="LEFT">signed_document_hash</TD></TR><TR><TD PORT="in_artist_signature" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_artist_signature" ALIGN="LEFT">artist_signature</TD></TR><TR><TD PORT="in_artist_signature_image" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_artist_signature_image" ALIGN="LEFT">artist_signature_image</TD></TR><TR><TD PORT="in_artist_signed_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_artist_signed_at" ALIGN="LEFT">artist_signed_at</TD></TR><TR><TD PORT="in_agreement_template_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_agreement_template_id" ALIGN="LEFT">agreement_template_id</TD></TR><TR><TD PORT="in_payment_deadline" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_payment_deadline" ALIGN="LEFT">payment_deadline</TD></TR><TR><TD PORT="in_winning_bid" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_winning_bid" ALIGN="LEFT">winning_bid</TD></TR><TR><TD PORT="in_winner_forfeited_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_winner_forfeited_at" ALIGN="LEFT">winner_forfeited_at</TD></TR><TR><TD PORT="in_backup_bidder_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_backup_bidder_id" ALIGN="LEFT">backup_bidder_id</TD></TR><TR><TD PORT="in_backup_offer_expires_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_backup_offer_expires_at" ALIGN="LEFT">backup_offer_expires_at</TD></TR><TR><TD PORT="in_created_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_created_at" ALIGN="LEFT">created_at</TD></TR></TABLE>>];
"auction_bid" [id="table-auction_bid", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>AUCTION_BID</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_auction_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_auction_id" ALIGN="LEFT">auction_id</TD></TR><TR><TD PORT="in_bidder_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_bidder_id" ALIGN="LEFT">bidder_id</TD></TR><TR><TD PORT="in_amount" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_amount" ALIGN="LEFT">amount</TD></TR><TR><TD PORT="in_created_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_created_at" ALIGN="LEFT">created_at</TD></TR><TR><TD PORT="in_terms_accepted_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_terms_accepted_at" ALIGN="LEFT">terms_accepted_at</TD></TR></TABLE>>];
"user" [id="table-user", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>USER</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR></TABLE>>];
"artwork" [id="table-artwork", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>ARTWORK</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_artist_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_artist_id" ALIGN="LEFT">artist_id</TD></TR></TABLE>>];
"agreement_template" [id="table-agreement_template", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>AGREEMENT_TEMPLATE</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_updated_by_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_updated_by_id" ALIGN="LEFT">updated_by_id</TD></TR></TABLE>>];
"user":"out_id":e -> "auction":"in_artist_id":w [id="relationship-0", arrowtail="odottee", arrowhead="crowodot", tooltip="user.id → auction.artist_id | one-to-many | parent 0..1 child 0..*"];
"artwork":"out_id":e -> "auction":"in_artwork_id":w [id="relationship-1", arrowtail="tee", arrowhead="crowodot", tooltip="artwork.id → auction.artwork_id | one-to-many | parent 1 child 0..*"];
"user":"out_id":e -> "auction":"in_highest_bidder_id":w [id="relationship-2", arrowtail="odottee", arrowhead="crowodot", tooltip="user.id → auction.highest_bidder_id | one-to-many | parent 0..1 child 0..*"];
"agreement_template":"out_id":e -> "auction":"in_agreement_template_id":w [id="relationship-3", arrowtail="odottee", arrowhead="crowodot", tooltip="agreement_template.id → auction.agreement_template_id | one-to-many | parent 0..1 child 0..*"];
"user":"out_id":e -> "auction":"in_backup_bidder_id":w [id="relationship-4", arrowtail="odottee", arrowhead="crowodot", tooltip="user.id → auction.backup_bidder_id | one-to-many | parent 0..1 child 0..*"];
"auction":"out_id":e -> "auction_bid":"in_auction_id":w [id="relationship-5", arrowtail="tee", arrowhead="crowodot", tooltip="auction.id → auction_bid.auction_id | one-to-many | parent 1 child 0..*"];
"user":"out_id":e -> "auction_bid":"in_bidder_id":w [id="relationship-6", arrowtail="tee", arrowhead="crowodot", tooltip="user.id → auction_bid.bidder_id | one-to-many | parent 1 child 0..*"];
