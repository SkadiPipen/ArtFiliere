digraph ERD { graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=12, label=<<FONT POINT-SIZE="18">Shopping carts</FONT><BR/><FONT POINT-SIZE="10">Parent: 1 or 0..1 | Child: 0..* or 0..1 | PK primary key | FK foreign key | UQ unique</FONT>>, labelloc=t, nodesep=0.65, ranksep=1.5, pad=0.4, splines=ortho, concentrate=false]; node [shape=plain, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.7, dir=both, arrowhead=none, arrowtail=none, labeldistance=2.4];
"cart" [id="table-cart", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>CART</B></FONT></TD></TR><TR><TD PORT="in_cart_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_cart_id" ALIGN="LEFT">cart_id</TD></TR><TR><TD PORT="in_buyer_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK UQ</TD><TD PORT="out_buyer_id" ALIGN="LEFT">buyer_id</TD></TR></TABLE>>];
"cart_item" [id="table-cart_item", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>CART_ITEM</B></FONT></TD></TR><TR><TD PORT="in_cart_item_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_cart_item_id" ALIGN="LEFT">cart_item_id</TD></TR><TR><TD PORT="in_cart_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_cart_id" ALIGN="LEFT">cart_id</TD></TR><TR><TD PORT="in_listing_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_listing_id" ALIGN="LEFT">listing_id</TD></TR><TR><TD PORT="in_quantity" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_quantity" ALIGN="LEFT">quantity</TD></TR></TABLE>>];
"user" [id="table-user", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>USER</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR></TABLE>>];
"artwork" [id="table-artwork", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>ARTWORK</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_artist_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_artist_id" ALIGN="LEFT">artist_id</TD></TR></TABLE>>];
"user":"out_id":e -> "cart":"in_buyer_id":w [id="relationship-0", arrowtail="tee", arrowhead="odottee", tooltip="user.id → cart.buyer_id | one-to-one | parent 1 child 0..1"];
"cart":"out_cart_id":e -> "cart_item":"in_cart_id":w [id="relationship-1", arrowtail="tee", arrowhead="crowodot", tooltip="cart.cart_id → cart_item.cart_id | one-to-many | parent 1 child 0..*"];
"artwork":"out_id":e -> "cart_item":"in_listing_id":w [id="relationship-2", arrowtail="tee", arrowhead="crowodot", tooltip="artwork.id → cart_item.listing_id | one-to-many | parent 1 child 0..*"];
}