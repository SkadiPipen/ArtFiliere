digraph ERD { graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=12, label=<<FONT POINT-SIZE="18">Legacy delivery</FONT><BR/><FONT POINT-SIZE="10">Parent: 1 or 0..1 | Child: 0..* or 0..1 | PK primary key | FK foreign key | UQ unique</FONT>>, labelloc=t, nodesep=0.65, ranksep=1.5, pad=0.4, splines=ortho, concentrate=false]; node [shape=plain, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.7, dir=both, arrowhead=none, arrowtail=none, labeldistance=2.4];
"legacy_rider_profile" [id="table-legacy_rider_profile", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>LEGACY_RIDER_PROFILE</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_user_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK UQ</TD><TD PORT="out_user_id" ALIGN="LEFT">user_id</TD></TR><TR><TD PORT="in_phone" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_phone" ALIGN="LEFT">phone</TD></TR><TR><TD PORT="in_is_clocked_in" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_is_clocked_in" ALIGN="LEFT">is_clocked_in</TD></TR><TR><TD PORT="in_clock_in_time" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_clock_in_time" ALIGN="LEFT">clock_in_time</TD></TR><TR><TD PORT="in_clock_out_time" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_clock_out_time" ALIGN="LEFT">clock_out_time</TD></TR><TR><TD PORT="in_current_latitude" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_current_latitude" ALIGN="LEFT">current_latitude</TD></TR><TR><TD PORT="in_current_longitude" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_current_longitude" ALIGN="LEFT">current_longitude</TD></TR></TABLE>>];
"legacy_delivery_order" [id="table-legacy_delivery_order", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>LEGACY_DELIVERY_ORDER</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_payment_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_payment_id" ALIGN="LEFT">payment_id</TD></TR><TR><TD PORT="in_buyerId" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_buyerId" ALIGN="LEFT">buyerId</TD></TR><TR><TD PORT="in_buyer_name" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_buyer_name" ALIGN="LEFT">buyer_name</TD></TR><TR><TD PORT="in_buyer_phone" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_buyer_phone" ALIGN="LEFT">buyer_phone</TD></TR><TR><TD PORT="in_address" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_address" ALIGN="LEFT">address</TD></TR><TR><TD PORT="in_delivery_latitude" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_delivery_latitude" ALIGN="LEFT">delivery_latitude</TD></TR><TR><TD PORT="in_delivery_longitude" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_delivery_longitude" ALIGN="LEFT">delivery_longitude</TD></TR><TR><TD PORT="in_artist_name" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_artist_name" ALIGN="LEFT">artist_name</TD></TR><TR><TD PORT="in_artist_phone" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_artist_phone" ALIGN="LEFT">artist_phone</TD></TR><TR><TD PORT="in_pickup_address" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_pickup_address" ALIGN="LEFT">pickup_address</TD></TR><TR><TD PORT="in_pickup_latitude" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_pickup_latitude" ALIGN="LEFT">pickup_latitude</TD></TR><TR><TD PORT="in_pickup_longitude" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_pickup_longitude" ALIGN="LEFT">pickup_longitude</TD></TR><TR><TD PORT="in_item_name" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_item_name" ALIGN="LEFT">item_name</TD></TR><TR><TD PORT="in_items_count" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_items_count" ALIGN="LEFT">items_count</TD></TR><TR><TD PORT="in_distance" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_distance" ALIGN="LEFT">distance</TD></TR><TR><TD PORT="in_estimatedTime" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_estimatedTime" ALIGN="LEFT">estimatedTime</TD></TR><TR><TD PORT="in_delivery_fee" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_delivery_fee" ALIGN="LEFT">delivery_fee</TD></TR><TR><TD PORT="in_is_priority" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_is_priority" ALIGN="LEFT">is_priority</TD></TR><TR><TD PORT="in_paymentMethod" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_paymentMethod" ALIGN="LEFT">paymentMethod</TD></TR><TR><TD PORT="in_status" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_status" ALIGN="LEFT">status</TD></TR><TR><TD PORT="in_assigned_rider_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_assigned_rider_id" ALIGN="LEFT">assigned_rider_id</TD></TR><TR><TD PORT="in_pickup_proof" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_pickup_proof" ALIGN="LEFT">pickup_proof</TD></TR><TR><TD PORT="in_delivery_proof" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_delivery_proof" ALIGN="LEFT">delivery_proof</TD></TR><TR><TD PORT="in_created_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_created_at" ALIGN="LEFT">created_at</TD></TR><TR><TD PORT="in_updated_at" ALIGN="LEFT" BORDER="1" SIDES="R"></TD><TD PORT="out_updated_at" ALIGN="LEFT">updated_at</TD></TR></TABLE>>];
"auth_user" [id="table-auth_user", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>AUTH_USER</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR></TABLE>>];
"payment" [id="table-payment", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#666666" STYLE="ROUNDED"><TR><TD COLSPAN="2" BORDER="1" SIDES="B" BGCOLOR="#ffffff"><FONT COLOR="#111111"><B>PAYMENT</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT" BORDER="1" SIDES="R">PK</TD><TD PORT="out_id" ALIGN="LEFT">id</TD></TR><TR><TD PORT="in_buyer_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_buyer_id" ALIGN="LEFT">buyer_id</TD></TR><TR><TD PORT="in_artist_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_artist_id" ALIGN="LEFT">artist_id</TD></TR><TR><TD PORT="in_artwork_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_artwork_id" ALIGN="LEFT">artwork_id</TD></TR><TR><TD PORT="in_agreement_id" ALIGN="LEFT" BORDER="1" SIDES="R">FK</TD><TD PORT="out_agreement_id" ALIGN="LEFT">agreement_id</TD></TR></TABLE>>];
"auth_user":"out_id":e -> "legacy_rider_profile":"in_user_id":w [id="relationship-0", arrowtail="tee", arrowhead="odottee", tooltip="auth_user.id → legacy_rider_profile.user_id | one-to-one | parent 1 child 0..1"];
"payment":"out_id":e -> "legacy_delivery_order":"in_payment_id":w [id="relationship-1", arrowtail="odottee", arrowhead="crowodot", tooltip="payment.id → legacy_delivery_order.payment_id | one-to-many | parent 0..1 child 0..*"];
"legacy_rider_profile":"out_id":e -> "legacy_delivery_order":"in_assigned_rider_id":w [id="relationship-2", arrowtail="odottee", arrowhead="crowodot", tooltip="legacy_rider_profile.id → legacy_delivery_order.assigned_rider_id | one-to-many | parent 0..1 child 0..*"];
