digraph ERD { graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=12, label=<<FONT POINT-SIZE="18">Artist applications</FONT><BR/><FONT POINT-SIZE="10">Parent: 1 or 0..1 | Child: 0..* or 0..1 | PK primary key | FK foreign key | UQ unique</FONT>>, labelloc=t, nodesep=0.4, ranksep=2.0, pad=0.4, splines=spline, concentrate=false]; node [shape=plain, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.7, dir=both, arrowhead=none, arrowtail=none, labeldistance=2.4];
"artist_application" [id="table-artist_application", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#143d59"><FONT COLOR="white"><B>artist_application</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_user_id" ALIGN="LEFT">FK UQ</TD><TD ALIGN="LEFT">user_id</TD><TD PORT="out_user_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_hourly_rate" ALIGN="LEFT"></TD><TD ALIGN="LEFT">hourly_rate</TD><TD PORT="out_hourly_rate" ALIGN="LEFT"><FONT COLOR="#475569">numeric(10, 2)</FONT></TD></TR><TR><TD PORT="in_tin_number" ALIGN="LEFT"></TD><TD ALIGN="LEFT">tin_number ?</TD><TD PORT="out_tin_number" ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD PORT="in_bio" ALIGN="LEFT"></TD><TD ALIGN="LEFT">bio ?</TD><TD PORT="out_bio" ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD></TR><TR><TD PORT="in_bir_certificate" ALIGN="LEFT"></TD><TD ALIGN="LEFT">bir_certificate</TD><TD PORT="out_bir_certificate" ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD></TR><TR><TD PORT="in_bir_certificate_name" ALIGN="LEFT"></TD><TD ALIGN="LEFT">bir_certificate_name</TD><TD PORT="out_bir_certificate_name" ALIGN="LEFT"><FONT COLOR="#475569">varchar(255)</FONT></TD></TR><TR><TD PORT="in_bir_expires_on" ALIGN="LEFT"></TD><TD ALIGN="LEFT">bir_expires_on ?</TD><TD PORT="out_bir_expires_on" ALIGN="LEFT"><FONT COLOR="#475569">date</FONT></TD></TR><TR><TD PORT="in_sworn_declaration" ALIGN="LEFT"></TD><TD ALIGN="LEFT">sworn_declaration</TD><TD PORT="out_sworn_declaration" ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD></TR><TR><TD PORT="in_sworn_declaration_name" ALIGN="LEFT"></TD><TD ALIGN="LEFT">sworn_declaration_name</TD><TD PORT="out_sworn_declaration_name" ALIGN="LEFT"><FONT COLOR="#475569">varchar(255)</FONT></TD></TR><TR><TD PORT="in_document_details" ALIGN="LEFT"></TD><TD ALIGN="LEFT">document_details</TD><TD PORT="out_document_details" ALIGN="LEFT"><FONT COLOR="#475569">jsonb</FONT></TD></TR><TR><TD PORT="in_portfolio" ALIGN="LEFT"></TD><TD ALIGN="LEFT">portfolio</TD><TD PORT="out_portfolio" ALIGN="LEFT"><FONT COLOR="#475569">jsonb</FONT></TD></TR><TR><TD PORT="in_status" ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD PORT="out_status" ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD PORT="in_rejection_reason" ALIGN="LEFT"></TD><TD ALIGN="LEFT">rejection_reason</TD><TD PORT="out_rejection_reason" ALIGN="LEFT"><FONT COLOR="#475569">varchar(500)</FONT></TD></TR><TR><TD PORT="in_submitted_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT">submitted_at</TD><TD PORT="out_submitted_at" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR><TR><TD PORT="in_updated_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT">updated_at</TD><TD PORT="out_updated_at" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR></TABLE>>];
"artist_registration_update" [id="table-artist_registration_update", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#143d59"><FONT COLOR="white"><B>artist_registration_update</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_application_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">application_id</TD><TD PORT="out_application_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_tin_number" ALIGN="LEFT"></TD><TD ALIGN="LEFT">tin_number</TD><TD PORT="out_tin_number" ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD PORT="in_evidence_image" ALIGN="LEFT"></TD><TD ALIGN="LEFT">evidence_image</TD><TD PORT="out_evidence_image" ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD></TR><TR><TD PORT="in_expires_on" ALIGN="LEFT"></TD><TD ALIGN="LEFT">expires_on ?</TD><TD PORT="out_expires_on" ALIGN="LEFT"><FONT COLOR="#475569">date</FONT></TD></TR><TR><TD PORT="in_previous_record" ALIGN="LEFT"></TD><TD ALIGN="LEFT">previous_record</TD><TD PORT="out_previous_record" ALIGN="LEFT"><FONT COLOR="#475569">jsonb</FONT></TD></TR><TR><TD PORT="in_status" ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD PORT="out_status" ALIGN="LEFT"><FONT COLOR="#475569">varchar(12)</FONT></TD></TR><TR><TD PORT="in_review_note" ALIGN="LEFT"></TD><TD ALIGN="LEFT">review_note</TD><TD PORT="out_review_note" ALIGN="LEFT"><FONT COLOR="#475569">varchar(1000)</FONT></TD></TR><TR><TD PORT="in_reviewed_by_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">reviewed_by_id ?</TD><TD PORT="out_reviewed_by_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_submitted_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT">submitted_at</TD><TD PORT="out_submitted_at" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR><TR><TD PORT="in_reviewed_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT">reviewed_at ?</TD><TD PORT="out_reviewed_at" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR></TABLE>>];
"artist_application_log" [id="table-artist_application_log", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#143d59"><FONT COLOR="white"><B>artist_application_log</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_application_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">application_id</TD><TD PORT="out_application_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_actor_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">actor_id ?</TD><TD PORT="out_actor_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_action" ALIGN="LEFT"></TD><TD ALIGN="LEFT">action</TD><TD PORT="out_action" ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD PORT="in_previous_status" ALIGN="LEFT"></TD><TD ALIGN="LEFT">previous_status</TD><TD PORT="out_previous_status" ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD PORT="in_new_status" ALIGN="LEFT"></TD><TD ALIGN="LEFT">new_status</TD><TD PORT="out_new_status" ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD PORT="in_reason" ALIGN="LEFT"></TD><TD ALIGN="LEFT">reason</TD><TD PORT="out_reason" ALIGN="LEFT"><FONT COLOR="#475569">varchar(500)</FONT></TD></TR><TR><TD PORT="in_created_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD PORT="out_created_at" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR></TABLE>>];
"user" [id="table-user", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#172b3a"><B>user</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR></TABLE>>];
"user":"out_id":e -> "artist_application":"in_user_id":w [id="relationship-0", label="user_id", taillabel="1", headlabel="0..1", tooltip="user.id → artist_application.user_id | one-to-one"];
"artist_application":"out_id":e -> "artist_registration_update":"in_application_id":w [id="relationship-1", label="application_id", taillabel="1", headlabel="0..*", tooltip="artist_application.id → artist_registration_update.application_id | one-to-many"];
