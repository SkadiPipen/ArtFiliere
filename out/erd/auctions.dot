digraph ERD { graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=12, label=<<FONT POINT-SIZE="18">Auctions</FONT><BR/><FONT POINT-SIZE="10">Parent: 1 or 0..1 | Child: 0..* or 0..1 | PK primary key | FK foreign key | UQ unique</FONT>>, labelloc=t, nodesep=0.4, ranksep=2.0, pad=0.4, splines=spline, concentrate=false]; node [shape=plain, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.7, dir=both, arrowhead=none, arrowtail=none, labeldistance=2.4];
"auction" [id="table-auction", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#143d59"><FONT COLOR="white"><B>auction</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_platform_defaults_snapshot" ALIGN="LEFT"></TD><TD ALIGN="LEFT">platform_defaults_snapshot</TD><TD PORT="out_platform_defaults_snapshot" ALIGN="LEFT"><FONT COLOR="#475569">jsonb</FONT></TD></TR><TR><TD PORT="in_artist_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">artist_id ?</TD><TD PORT="out_artist_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_artwork_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">artwork_id</TD><TD PORT="out_artwork_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_starting_bid" ALIGN="LEFT"></TD><TD ALIGN="LEFT">starting_bid</TD><TD PORT="out_starting_bid" ALIGN="LEFT"><FONT COLOR="#475569">numeric(12, 2)</FONT></TD></TR><TR><TD PORT="in_current_bid" ALIGN="LEFT"></TD><TD ALIGN="LEFT">current_bid</TD><TD PORT="out_current_bid" ALIGN="LEFT"><FONT COLOR="#475569">numeric(12, 2)</FONT></TD></TR><TR><TD PORT="in_bid_increment" ALIGN="LEFT"></TD><TD ALIGN="LEFT">bid_increment</TD><TD PORT="out_bid_increment" ALIGN="LEFT"><FONT COLOR="#475569">numeric(10, 2)</FONT></TD></TR><TR><TD PORT="in_start_time" ALIGN="LEFT"></TD><TD ALIGN="LEFT">start_time</TD><TD PORT="out_start_time" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR><TR><TD PORT="in_end_time" ALIGN="LEFT"></TD><TD ALIGN="LEFT">end_time</TD><TD PORT="out_end_time" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR><TR><TD PORT="in_status" ALIGN="LEFT"></TD><TD ALIGN="LEFT">status</TD><TD PORT="out_status" ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD PORT="in_highest_bidder_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">highest_bidder_id ?</TD><TD PORT="out_highest_bidder_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_is_physical" ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_physical</TD><TD PORT="out_is_physical" ALIGN="LEFT"><FONT COLOR="#475569">boolean</FONT></TD></TR><TR><TD PORT="in_license_type" ALIGN="LEFT"></TD><TD ALIGN="LEFT">license_type</TD><TD PORT="out_license_type" ALIGN="LEFT"><FONT COLOR="#475569">varchar(30)</FONT></TD></TR><TR><TD PORT="in_exclusivity" ALIGN="LEFT"></TD><TD ALIGN="LEFT">exclusivity</TD><TD PORT="out_exclusivity" ALIGN="LEFT"><FONT COLOR="#475569">varchar(30)</FONT></TD></TR><TR><TD PORT="in_delivery_type" ALIGN="LEFT"></TD><TD ALIGN="LEFT">delivery_type</TD><TD PORT="out_delivery_type" ALIGN="LEFT"><FONT COLOR="#475569">varchar(30)</FONT></TD></TR><TR><TD PORT="in_terms_snapshot" ALIGN="LEFT"></TD><TD ALIGN="LEFT">terms_snapshot</TD><TD PORT="out_terms_snapshot" ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD></TR><TR><TD PORT="in_signed_document" ALIGN="LEFT"></TD><TD ALIGN="LEFT">signed_document</TD><TD PORT="out_signed_document" ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD></TR><TR><TD PORT="in_signed_document_hash" ALIGN="LEFT"></TD><TD ALIGN="LEFT">signed_document_hash</TD><TD PORT="out_signed_document_hash" ALIGN="LEFT"><FONT COLOR="#475569">varchar(64)</FONT></TD></TR><TR><TD PORT="in_artist_signature" ALIGN="LEFT"></TD><TD ALIGN="LEFT">artist_signature</TD><TD PORT="out_artist_signature" ALIGN="LEFT"><FONT COLOR="#475569">varchar(200)</FONT></TD></TR><TR><TD PORT="in_artist_signature_image" ALIGN="LEFT"></TD><TD ALIGN="LEFT">artist_signature_image</TD><TD PORT="out_artist_signature_image" ALIGN="LEFT"><FONT COLOR="#475569">text</FONT></TD></TR><TR><TD PORT="in_artist_signed_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT">artist_signed_at ?</TD><TD PORT="out_artist_signed_at" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR><TR><TD PORT="in_agreement_template_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">agreement_template_id ?</TD><TD PORT="out_agreement_template_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_payment_deadline" ALIGN="LEFT"></TD><TD ALIGN="LEFT">payment_deadline ?</TD><TD PORT="out_payment_deadline" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR><TR><TD PORT="in_winning_bid" ALIGN="LEFT"></TD><TD ALIGN="LEFT">winning_bid ?</TD><TD PORT="out_winning_bid" ALIGN="LEFT"><FONT COLOR="#475569">numeric(12, 2)</FONT></TD></TR><TR><TD PORT="in_winner_forfeited_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT">winner_forfeited_at ?</TD><TD PORT="out_winner_forfeited_at" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR><TR><TD PORT="in_backup_bidder_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">backup_bidder_id ?</TD><TD PORT="out_backup_bidder_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_backup_offer_expires_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT">backup_offer_expires_at ?</TD><TD PORT="out_backup_offer_expires_at" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR><TR><TD PORT="in_created_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD PORT="out_created_at" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR></TABLE>>];
"auction_bid" [id="table-auction_bid", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#143d59"><FONT COLOR="white"><B>auction_bid</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_auction_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">auction_id</TD><TD PORT="out_auction_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_bidder_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">bidder_id</TD><TD PORT="out_bidder_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_amount" ALIGN="LEFT"></TD><TD ALIGN="LEFT">amount</TD><TD PORT="out_amount" ALIGN="LEFT"><FONT COLOR="#475569">numeric(12, 2)</FONT></TD></TR><TR><TD PORT="in_created_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT">created_at</TD><TD PORT="out_created_at" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR><TR><TD PORT="in_terms_accepted_at" ALIGN="LEFT"></TD><TD ALIGN="LEFT">terms_accepted_at ?</TD><TD PORT="out_terms_accepted_at" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR></TABLE>>];
"user" [id="table-user", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#172b3a"><B>user</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR></TABLE>>];
"artwork" [id="table-artwork", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#172b3a"><B>artwork</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_artist_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">artist_id</TD><TD PORT="out_artist_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR></TABLE>>];
"agreement_template" [id="table-agreement_template", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#172b3a"><B>agreement_template</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_updated_by_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">updated_by_id ?</TD><TD PORT="out_updated_by_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR></TABLE>>];
"user":"out_id":e -> "auction":"in_artist_id":w [id="relationship-0", label="artist_id", taillabel="0..1", headlabel="0..*", tooltip="user.id → auction.artist_id | one-to-many"];
"artwork":"out_id":e -> "auction":"in_artwork_id":w [id="relationship-1", label="artwork_id", taillabel="1", headlabel="0..*", tooltip="artwork.id → auction.artwork_id | one-to-many"];
"user":"out_id":e -> "auction":"in_highest_bidder_id":w [id="relationship-2", label="highest_bidder_id", taillabel="0..1", headlabel="0..*", tooltip="user.id → auction.highest_bidder_id | one-to-many"];
