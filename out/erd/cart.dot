digraph ERD { graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=12, label=<<FONT POINT-SIZE="18">Shopping carts</FONT><BR/><FONT POINT-SIZE="10">Parent: 1 or 0..1 | Child: 0..* or 0..1 | PK primary key | FK foreign key | UQ unique</FONT>>, labelloc=t, nodesep=0.4, ranksep=2.0, pad=0.4, splines=spline, concentrate=false]; node [shape=plain, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.7, dir=both, arrowhead=none, arrowtail=none, labeldistance=2.4];
"cart" [id="table-cart", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#143d59"><FONT COLOR="white"><B>cart</B></FONT></TD></TR><TR><TD PORT="in_cart_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">cart_id</TD><TD PORT="out_cart_id" ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD PORT="in_buyer_id" ALIGN="LEFT">FK UQ</TD><TD ALIGN="LEFT">buyer_id</TD><TD PORT="out_buyer_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR></TABLE>>];
"cart_item" [id="table-cart_item", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#143d59"><FONT COLOR="white"><B>cart_item</B></FONT></TD></TR><TR><TD PORT="in_cart_item_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">cart_item_id</TD><TD PORT="out_cart_item_id" ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD PORT="in_cart_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">cart_id</TD><TD PORT="out_cart_id" ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD PORT="in_listing_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">listing_id</TD><TD PORT="out_listing_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_quantity" ALIGN="LEFT"></TD><TD ALIGN="LEFT">quantity</TD><TD PORT="out_quantity" ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR></TABLE>>];
"user" [id="table-user", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#172b3a"><B>user</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR></TABLE>>];
"artwork" [id="table-artwork", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#e2e8f0"><FONT COLOR="#172b3a"><B>artwork</B> (reference)</FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_artist_id" ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">artist_id</TD><TD PORT="out_artist_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR></TABLE>>];
"user":"out_id":e -> "cart":"in_buyer_id":w [id="relationship-0", label="buyer_id", taillabel="1", headlabel="0..1", tooltip="user.id → cart.buyer_id | one-to-one"];
"cart":"out_cart_id":e -> "cart_item":"in_cart_id":w [id="relationship-1", label="cart_id", taillabel="1", headlabel="0..*", tooltip="cart.cart_id → cart_item.cart_id | one-to-many"];
"artwork":"out_id":e -> "cart_item":"in_listing_id":w [id="relationship-2", label="listing_id", taillabel="1", headlabel="0..*", tooltip="artwork.id → cart_item.listing_id | one-to-many"];
}