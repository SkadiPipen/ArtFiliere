digraph ERD { graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=12, label=<<FONT POINT-SIZE="18">Legacy delivery</FONT><BR/><FONT POINT-SIZE="10">Parent: 1 or 0..1 | Child: 0..* or 0..1 | PK primary key | FK foreign key | UQ unique</FONT>>, labelloc=t, nodesep=0.4, ranksep=2.0, pad=0.4, splines=spline, concentrate=false]; node [shape=plain, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.7, dir=both, arrowhead=none, arrowtail=none, labeldistance=2.4];
"legacy_rider_profile" [id="table-legacy_rider_profile", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#94a3b8"><TR><TD COLSPAN="3" BGCOLOR="#143d59"><FONT COLOR="white"><B>legacy_rider_profile</B></FONT></TD></TR><TR><TD PORT="in_id" ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id</TD><TD PORT="out_id" ALIGN="LEFT"><FONT COLOR="#475569">bigint</FONT></TD></TR><TR><TD PORT="in_user_id" ALIGN="LEFT">FK UQ</TD><TD ALIGN="LEFT">user_id</TD><TD PORT="out_user_id" ALIGN="LEFT"><FONT COLOR="#475569">integer</FONT></TD></TR><TR><TD PORT="in_phone" ALIGN="LEFT"></TD><TD ALIGN="LEFT">phone</TD><TD PORT="out_phone" ALIGN="LEFT"><FONT COLOR="#475569">varchar(20)</FONT></TD></TR><TR><TD PORT="in_is_clocked_in" ALIGN="LEFT"></TD><TD ALIGN="LEFT">is_clocked_in</TD><TD PORT="out_is_clocked_in" ALIGN="LEFT"><FONT COLOR="#475569">boolean</FONT></TD></TR><TR><TD PORT="in_clock_in_time" ALIGN="LEFT"></TD><TD ALIGN="LEFT">clock_in_time ?</TD><TD PORT="out_clock_in_time" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR><TR><TD PORT="in_clock_out_time" ALIGN="LEFT"></TD><TD ALIGN="LEFT">clock_out_time ?</TD><TD PORT="out_clock_out_time" ALIGN="LEFT"><FONT COLOR="#475569">timestamp with time zone</FONT></TD></TR><TR><TD PORT="in_current_latitude" ALIGN="LEFT"></TD><TD ALIGN="LEFT">current_latitude ?</TD><TD PORT="out_current_latitude" ALIGN="LEFT"><FONT COLOR="#475569">double precision</FONT></TD></TR><TR><TD PORT="in_current_longitude" ALIGN="LEFT"></TD><TD ALIGN="LEFT">current_longitude ?</TD><TD PORT="out_current_longitude" ALIGN="LEFT"><FONT COLOR="#475569">double precision</FONT></TD></TR></TABLE>>];
