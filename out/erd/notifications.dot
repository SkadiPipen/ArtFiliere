digraph ERD { graph [rankdir=LR, bgcolor="white", fontname="Arial", fontsize=12, label=<<FONT POINT-SIZE="18">Notifications</FONT><BR/><FONT POINT-SIZE="10">Parent: 1 or 0..1 | Child: 0..* or 0..1 | PK primary key | FK foreign key | UQ unique</FONT>>, labelloc=t, nodesep=0.4, ranksep=2.0, pad=0.4, splines=spline, concentrate=false]; node [shape=plain, fontname="Arial", fontsize=10]; edge [fontname="Arial", fontsize=8, color="#64748b", fontcolor="#334155", arrowsize=0.7, dir=both, arrowhead=none, arrowtail=none, labeldistance=2.4];
